# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic Claude API
# Get a key from https://console.anthropic.com (needs at least $5 in credit)
# Required for every Oracle response.
# ─────────────────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Get this from Railway, Render, Supabase, or any Postgres host.
# Format: postgresql://user:password@host:port/dbname
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/poe2_oracle

# ─────────────────────────────────────────────────────────────────────────────
# JWT signing secret
# Generate with: openssl rand -base64 32
# Used to sign auth tokens. NEVER share. Rotate if leaked.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Public app URL (optional, used for emails / OAuth callbacks later)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
